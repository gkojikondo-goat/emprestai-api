# Postgres de desenvolvimento (docker-compose.yml). Copie este arquivo para .env.
# Valores de exemplo para o banco LOCAL; nunca use credenciais reais aqui.
POSTGRES_USER=emprestai
POSTGRES_PASSWORD=emprestai
POSTGRES_DB=emprestai
POSTGRES_PORT=5432

# API
PORT=3000
DATABASE_URL=postgresql://emprestai:emprestai@localhost:5432/emprestai
DIRECT_URL=postgresql://emprestai:emprestai@localhost:5432/emprestai
